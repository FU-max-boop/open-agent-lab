{
  "name": "open-agent-lab",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -b packages/contracts packages/evidence packages/model-driver apps/cli",
    "clean": "tsc -b --clean packages/contracts packages/evidence packages/model-driver apps/cli",
    "typecheck": "tsc -b --pretty false packages/contracts packages/evidence packages/model-driver apps/cli && tsc -p packages/model-driver/tsconfig.test.json --pretty false",
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
